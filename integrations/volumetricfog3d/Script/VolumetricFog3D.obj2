--information:VolumetricFog3D v2.06
--
-- 3D 空間に「霧」を描くカスタムオブジェクト（GPU 3D FBM アトラス ＋ ハードウェア Z バッファ体積法）。
--
--   ・GPU のピクセルシェーダー（HLSL）で 4 オクターブ 3D FBM ノイズ・
--     Beer-Lambert 透過率・Henyey-Greenstein 前方散乱・高度指数減衰を高速計算
--   ・各スライスを 3D ポリゴンとして描画するため、AviUtl2 本体のハードウェア
--     Z バッファとそのまま噛み合い、手前の石膏像や人物はくっきり・奥の彩窓や
--     背景ほど深い霧に包まれる「本物の 3D 遮蔽」が自動で得られる
--   ・プレビューの「編集用視点（緑のカメラアイコン）」を検出（camera_mode == 2）し、
--     注視点を中心とする 3D 球体ボリュームへ自動切替するため、
--     横や斜めへ自由に回り込んでも「謎の縦縞・断面の角」が出ない
--
-- v2.06 更新点（VL3DLF v3 体積光連携）:
--   ・散乱光源に「手動方向 / 体積光連携」を追加。既定の手動方向は従来どおり。
--   ・連携モードは同一シーンの VolumetricLight3D 光場を読み、4×4×最大64スライスの
--     空間サンプルごとに局所放射輝度・光方向・投射陰影を反映して Henyey-Greenstein 散乱を計算。
--   ・光場が未登録/古い/読めないとき自動で手動方向へ戻り、ゼロ光源や時間軸シークで残光しない。
--
-- v2.05 更新点（2026-10-24・スクリプト名称を「VolumetricFog3D」へ変更）:
--   ・スクリプト識別名を「体積霧（3D）」から「VolumetricFog3D」へ変更（--information・ファイル名・
--     言語パケットの対応セクション名）。UI 上の表示名は言語パケットにより従来どおり
--     「体积雾（3D）」「Volumetric Fog (3D)」「Volumennebel (3D)」等で表示されます。
--   ・エラー出力に残存していた旧バージョン表記（v2.03）を v2.05 表記へ統一。
--   ・簡体中文言語パケット（.aul2）の用語「自定义对象」を「自定义物件」へ統一（UI 表示のみの変更）。
--   ・既存プロジェクト（.aup2）で旧名称「体積霧（3D）」を参照しているオブジェクトは、旧バージョンの
--     スクリプトを併置するか本 v2.05 を追加し直してください。また「体積光（3D）」は v3.07 以降、
--     新名称の霧レイヤーを体積効果レイヤーとして自動認識します（旧名称の認識も維持）。
--
-- v2.04 更新点（2026-10-24・AviUtl ExEdit2 v2.1.15 & VL3DBridge v1.20 対応）:
--   ・`vfog_try_edit_camera()` の `VL3DBridge.aux2` 取得経路に AviUtl2 公式モジュール API
--     `obj.module("VL3DBridge")` を最優先で追加（`require` 単体では `.aux2` スクリプトモジュールが
--     解決されない実機環境でもライブ編集用視点 `get_edit_camera` が確実に接続）。
--   ・制限付き Lua 環境（`os == nil`, `io == nil`）での単調時計フォールバック（`VL3DBridge.wall_time_sec()` /
--     `obj.getinfo("clock")`）を導入し、初回以降の `@info` ログが `0.0 - 0.0 < 0.25` で永久抑制される問題を解消。
--   ・`io == nil` 環境でも Win32 `CreateFileW` / `GetEnvironmentVariableW` 経由で `aviutl2.ini` の UI 言語を検出可能に改善。
--
-- v2.03 更新点:
--   ・球状ボリュームモード（p7.z > 0.5）で平面スライス用の正割補正 sec(theta) が最大 4.0 倍まで
--     過乗算され、広角周辺部の霧濃度が +33.6% 過剰になる問題を修正（球状モード時は sec_k = 1.0）。
--   ・編集用視点（camera_mode == 2）の挙動を改善:
--     VL3DBridge.aux2 導入環境ではライブ編集カメラ姿勢を直接取得して世界座標基底（billboard=0）で描画し、
--     単体動作時も「高さ減衰 > 0」または「カメラ制御あり」の場合は billboard=3 による世界 Y 軸の傾きを防止。
--   ・チェック項目（log_mode）の数値 0 判定（as_bool）を厳密化し、aviutl2.ini の UI 言語判定を
--     セッション永続キャッシュ（_G._VFOG3D_PERSIST）化して毎フレームのディスク I/O とログ洪水を解消。
--
--   ※ 合成モードは標準属性の「通常」のまま使ってください（加算だと白飛びします）。

--group:霧,true
--track@density:濃さ,0,100,60,1
--color@fog_color:霧の色,0xa8bcd8
--track@noise_scale:模様の大きさ,50,4000,550,10
--track@pattern:模様の強さ,0,100,85,1
--group

--group:流れ,true
--track@wind_x:風X,-2000,2000,15,1
--track@wind_y:風Y,-2000,2000,0,1
--track@wind_z:風Z,-2000,2000,0,1
--track@turbulence:揺らぎ速さ,0,10,2,0.1
--group

--group:領域・高さ,true
--track@area_z:手前の距離,0,20000,150,10
--track@area_d:奥行き,100,30000,3200,100
--track@spread:画面の広がり,100,250,135,1
--track@height_fall:高さ減衰,0,100,0,1
--track@height_y:基準の高さY,-10000,10000,200,10
--group

--group:散乱光,false
--track@scatter:散乱の強さ,0,100,25,1
--color@light_color:光の色,0xdce6ff
--track@hg_g:前方散乱(g),-0.9,0.9,0.45,0.01
--track@light_x:光の向きX,-1,1,0,0.01
--track@light_y:光の向きY,-1,1,0.25,0.01
--track@light_z:光の向きZ,-1,1,-1,0.01
--select@scatter_source:散射光来源=0,手动方向=0,体积光联动=1
--group

--group:描画,true
--track@slices:スライス数,8,64,48,1
--select@res_mode:テクスチャ品質=1,軽量(1/2)=0,標準=1
--select@view_mode:視点追従=0,自動(編集視点対応)=0,カメラ制御に固定=1,3D球ボリューム=2
--track@depth_fade:奥行き減衰,0,100,25,1
--track@seed:乱数シード,0,9999,0,1
--check@log_mode:ログに出力,true
--group

--[[pixelshader@fogatlas:
    cbuffer FogCB : register(b0)
    {
        float4 p0;  // x: tile_size, y: tiles_x, z: n_slices, w: pad_px
        float4 p1;  // xyz: origin,  w: start_s
        float4 p2;  // xyz: fwd,     w: dz
        float4 p3;  // xyz: right,   w: hw_k (or R_vol)
        float4 p4;  // xyz: down,    w: hh_k (or RY_vol)
        float4 p5;  // xyz: wind_ofs, w: inv_nscale
        float4 p6;  // xyz: fog_rgb, w: sigma_dz
        float4 p7;  // x: pattern, y: dfade, z: mode_sphere, w: anim_t
        float4 p8;  // xyz: light_dir, w: hg_g
        float4 p9;  // xyz: light_rgb_scaled, w: h_fall_k
        float4 p10; // x: height_y, y: inner_u, z: jitter_k, w: cam_dist_y
        float4 p11; // xyz: cam_pos, w: shared light-field mode
        float4 lf_col[1024]; // 64 slices x 4 x 4 spatial light samples
        float4 lf_dir[1024]; // per-sample weighted light travel direction
    };

    float hash31(float3 ip)
    {
        float3 q = ip - floor(ip / 289.0) * 289.0;
        float d = dot(q, float3(127.1, 311.7, 74.7));
        return frac(sin(d) * 43758.5453);
    }

    float vnoise3(float3 x)
    {
        float3 i = floor(x);
        float3 f = x - i;
        float3 u = f * f * (3.0 - 2.0 * f);

        float c000 = hash31(i + float3(0.0, 0.0, 0.0));
        float c100 = hash31(i + float3(1.0, 0.0, 0.0));
        float c010 = hash31(i + float3(0.0, 1.0, 0.0));
        float c110 = hash31(i + float3(1.0, 1.0, 0.0));
        float c001 = hash31(i + float3(0.0, 0.0, 1.0));
        float c101 = hash31(i + float3(1.0, 0.0, 1.0));
        float c011 = hash31(i + float3(0.0, 1.0, 1.0));
        float c111 = hash31(i + float3(1.0, 1.0, 1.0));

        float x00 = lerp(c000, c100, u.x);
        float x10 = lerp(c010, c110, u.x);
        float x01 = lerp(c001, c101, u.x);
        float x11 = lerp(c011, c111, u.x);
        float y0  = lerp(x00, x10, u.y);
        float y1  = lerp(x01, x11, u.y);
        return lerp(y0, y1, u.z);
    }

    float fbm4(float3 q, float anim)
    {
        float v  = 0.500 * vnoise3(q + float3(anim * 0.11, -anim * 0.07, anim * 0.05));
        v += 0.260 * vnoise3(q * 2.03 + float3(-anim * 0.17 + 11.3, anim * 0.13 - 7.1, 5.7));
        v += 0.150 * vnoise3(q * 4.07 + float3(anim * 0.23 - 3.9, 13.7, -anim * 0.19 - 9.2));
        v += 0.090 * vnoise3(q * 8.13 + float3(7.7, -anim * 0.29 + 3.1, 17.3));
        return v;
    }

    float4 fogatlas(float4 pos : SV_Position) : SV_Target
    {
        float tile_sz = p0.x;
        float tiles_x = p0.y;
        float n_sl    = p0.z;
        float pad_px  = p0.w;

        float tx = floor(pos.x / tile_sz);
        float ty = floor(pos.y / tile_sz);
        float si = ty * tiles_x + tx;
        if (si >= n_sl)
        {
            return float4(0.0, 0.0, 0.0, 0.0);
        }

        float span = max(tile_sz - 2.0 * pad_px, 1.0);
        float lu = saturate((pos.x - tx * tile_sz - pad_px) / span) * 2.0 - 1.0;
        float lv = saturate((pos.y - ty * tile_sz - pad_px) / span) * 2.0 - 1.0;

        float dz = p2.w;
        float ign = frac(sin(pos.x * 0.0605 + pos.y * 0.0076 + si * 0.2312) * 43758.5453);
        float z_jit = (ign - 0.5) * dz * p10.z;

        float3 wpos;
        float env = 1.0;

        if (p7.z < 0.5)
        {
            float z = p1.w + (si + 0.5) * dz + z_jit;
            wpos = p1.xyz + p2.xyz * z + p3.xyz * (lu * p3.w * z) + p4.xyz * (lv * p4.w * z);

            float denom_e = max(1.0 - p10.y, 0.05);
            float eu = saturate((1.0 - abs(lu)) / denom_e);
            float ev = saturate((1.0 - abs(lv)) / denom_e);
            float edge = (eu * eu * (3.0 - 2.0 * eu)) * (ev * ev * (3.0 - 2.0 * ev));

            float e0 = si / max(n_sl - 1.0, 1.0);
            float ef = saturate(min(e0 / 0.08, (1.0 - e0) / 0.08));
            float df = (1.0 - p7.y) + p7.y * e0;
            env = df * (0.25 + 0.75 * ef) * edge;
        }
        else
        {
            float r_vol  = p3.w;
            float ry_vol = p4.w;
            float s = p1.w + (si + 0.5) * dz + z_jit;
            float rad_s = max(200.0, sqrt(max(0.0, r_vol * r_vol - s * s)));
            float lx = lu * rad_s;
            float ly = lv * rad_s * (ry_vol / max(r_vol, 1.0));
            wpos = p1.xyz + p2.xyz * s + p3.xyz * lx + p4.xyz * ly;

            float3 rel = wpos - p1.xyz;
            float3 dn = float3(rel.x / max(r_vol, 1.0), rel.y / max(ry_vol, 1.0), rel.z / max(r_vol, 1.0));
            float tf = saturate((1.0 - length(dn)) / 0.58);
            env = tf * tf * (3.0 - 2.0 * tf);
        }

        float n = fbm4((wpos + p5.xyz) * p5.w, p7.w);
        float c_raw = clamp((n - 0.34) / 0.42, 0.0, 1.6);
        float dens_f = (0.06 + 2.35 * c_raw * sqrt(c_raw)) * p7.x + 0.72 * (1.0 - p7.x);

        if (p9.w > 0.0)
        {
            float h_above = max(0.0, p10.x - wpos.y);
            dens_f *= exp(-h_above * p9.w);
        }

        float3 vvec = wpos - p11.xyz;
        float  vlen = max(length(vvec), 1e-4);
        float3 vdir = vvec / vlen;

        // 斜め視線に対するスライス通過厚みの正割補正 sec(theta) = 1 / |dot(vdir, sl_n)|
        // ※ 球状ボリューム（p7.z > 0.5）ではカメラが球内に入る／編集視点時の過乗算を防ぐため 1.0 固定
        float3 sl_n = normalize(p2.xyz);
        float sec_k = (p7.z > 0.5) ? 1.0 : (1.0 / max(abs(dot(vdir, sl_n)), 0.25));
        float od = max(p6.w * sec_k * env * dens_f, 0.0);
        float alpha = 1.0 - exp(-od);

        // p8.xyz は「光が進む向き」なので、前向散乱角 cos(theta) は -dot(vdir, p8.xyz)
        float cosA = -dot(vdir, p8.xyz);
        float g = clamp(p8.w, -0.92, 0.92);
        float g2 = g * g;
        float d_hg = max(1.0 + g2 - 2.0 * g * cosA, 1e-4);
        float phase = (1.0 - g2) / (d_hg * sqrt(d_hg));
        // 高 g 時の極端な白飛び・色環断層を滑らかに抑制
        phase = phase / (1.0 + 0.08 * max(phase - 1.0, 0.0));

        float3 light_add = p9.xyz * phase;
        if (p11.w > 0.5)
        {
            float gx_f = (pos.x - tx * tile_sz) / tile_sz;
            float gy_f = (pos.y - ty * tile_sz) / tile_sz;
            int gx_i = (int)clamp(floor(gx_f * 4.0), 0.0, 3.0);
            int gy_i = (int)clamp(floor(gy_f * 4.0), 0.0, 3.0);
            int lf_i = (int)si * 16 + gy_i * 4 + gx_i;
            float4 lf_c = lf_col[lf_i];
            float4 lf_d = lf_dir[lf_i];
            if (lf_c.w > 1e-5 && dot(lf_d.xyz, lf_d.xyz) > 1e-6)
            {
                float3 ldir = normalize(lf_d.xyz);
                float cos_l = -dot(vdir, ldir);
                float den_l = max(1.0 + g2 - 2.0 * g * cos_l, 1e-4);
                float phase_l = (1.0 - g2) / (den_l * sqrt(den_l));
                phase_l = phase_l / (1.0 + 0.08 * max(phase_l - 1.0, 0.0));
                light_add = lf_c.rgb * phase_l;
            }
            else
            {
                light_add = 0.0;
            }
        }
        float3 scol = saturate(p6.xyz + light_add);
        return float4(scol * alpha, alpha);
    }
]]

---------------------------------------------------------------------
-- 本体
---------------------------------------------------------------------
local obj, math = obj, math

_G._VFOG3D_PERSIST = _G._VFOG3D_PERSIST or {}
local _VFOG_PERSIST = _G._VFOG3D_PERSIST

local function as_bool(v, def)
    if v == nil then return def end
    if type(v) == "boolean" then return v end
    if type(v) == "number" then return v ~= 0 end
    if type(v) == "string" then
        return v == "1" or v:lower() == "true"
    end
    return def
end

local function vfog_ensure_bridge()
    if _VFOG_PERSIST.bridge_checked == nil then
        _VFOG_PERSIST.bridge_checked = true
        local mod = nil
        if type(obj) == "table" and type(obj.module) == "function" then
            local ok_om, m0 = pcall(obj.module, "VL3DBridge")
            if ok_om and type(m0) == "table" then mod = m0 end
        end
        if type(mod) ~= "table" and type(package) == "table" and type(package.loaded) == "table" then
            mod = package.loaded["VL3DBridge"]
        end
        if type(mod) ~= "table" then
            local ok_m, m2 = pcall(require, "VL3DBridge")
            if ok_m and type(m2) == "table" then mod = m2 end
        end
        _VFOG_PERSIST.bridge = (type(mod) == "table") and mod or false
    end
    return _VFOG_PERSIST.bridge
end

local function vfog_try_edit_camera()
    if type(_G.VFOG3D_TEST_EDIT_CAM) == "table" then
        return _G.VFOG3D_TEST_EDIT_CAM
    end
    if type(_G.VL3D_TEST_EDIT_CAM) == "table" then
        return _G.VL3D_TEST_EDIT_CAM
    end
    local br = vfog_ensure_bridge()
    if type(br) == "table" and type(br.get_edit_camera) == "function" then
        local ok_c, okcam, x, y, z, tx, ty, tz, ux, uy, uz, rz, d = pcall(br.get_edit_camera)
        if ok_c and okcam == true then
            return {
                x = tonumber(x) or 0, y = tonumber(y) or 0, z = tonumber(z) or -1024,
                tx = tonumber(tx) or 0, ty = tonumber(ty) or 0, tz = tonumber(tz) or 0,
                ux = tonumber(ux) or 0, uy = tonumber(uy) or -1, uz = tonumber(uz) or 0,
                rz = tonumber(rz) or 0, d = tonumber(d) or 1024,
            }
        end
    end
    return nil
end

local function vfog_wall_time_sec()
    local br = vfog_ensure_bridge()
    if type(br) == "table" and type(br.wall_time_sec) == "function" then
        local ok_w, wt = pcall(br.wall_time_sec)
        if ok_w and type(wt) == "number" then return wt end
    end
    local qpc = _VFOG_PERSIST.qpc
    if qpc == nil then
        qpc = { mode = 0 }
        pcall(function()
            local ok_f, ffi = pcall(require, "ffi")
            if not (ok_f and ffi ~= nil) then return end
            if ffi.os == "Windows" then
                pcall(ffi.cdef, "int QueryPerformanceFrequency(void*);")
                pcall(ffi.cdef, "int QueryPerformanceCounter(void*);")
                local fn_f = ffi.cast("int (__stdcall *)(void*)", ffi.C.QueryPerformanceFrequency)
                local fn_c = ffi.cast("int (__stdcall *)(void*)", ffi.C.QueryPerformanceCounter)
                local hz = ffi.new("int64_t[1]")
                if fn_f(hz) ~= 0 and tonumber(hz[0]) > 0 then
                    qpc.mode = 1
                    qpc.fn = fn_c
                    qpc.inv = 1.0 / tonumber(hz[0])
                    qpc.buf = ffi.new("int64_t[1]")
                end
            else
                pcall(ffi.cdef, "int clock_gettime(int, void*);")
                local fn_cg = ffi.cast("int (*)(int, void*)", ffi.C.clock_gettime)
                local ts = ffi.new("int64_t[2]")
                if fn_cg(1, ts) == 0 then
                    qpc.mode = 2
                    qpc.fn = fn_cg
                    qpc.ts = ts
                    qpc.t0 = tonumber(ts[0]) + tonumber(ts[1]) * 1e-9
                end
            end
        end)
        _VFOG_PERSIST.qpc = qpc
    end
    if qpc.mode == 1 and qpc.fn(qpc.buf) ~= 0 then
        return tonumber(qpc.buf[0]) * qpc.inv
    elseif qpc.mode == 2 and qpc.fn(1, qpc.ts) == 0 then
        return (tonumber(qpc.ts[0]) + tonumber(qpc.ts[1]) * 1e-9) - qpc.t0
    end
    if type(obj) == "table" and type(obj.getinfo) == "function" then
        local ok_c, clk = pcall(obj.getinfo, "clock")
        if ok_c and type(clk) == "number" then return clk end
    end
    if type(os) == "table" and type(os.clock) == "function" then
        return os.clock()
    end
    return (type(obj) == "table" and type(obj.time) == "number") and obj.time or 0.0
end

local function vfog_utf8_to_u16(ffi, s)
    local codes = {}
    local i, n = 1, #s
    while i <= n do
        local b1 = s:byte(i)
        local cp
        if b1 < 0x80 then cp = b1; i = i + 1
        elseif b1 < 0xE0 and i + 1 <= n then cp = (b1 - 0xC0) * 64 + (s:byte(i + 1) - 0x80); i = i + 2
        elseif b1 < 0xF0 and i + 2 <= n then cp = (b1 - 0xE0) * 4096 + (s:byte(i + 1) - 0x80) * 64 + (s:byte(i + 2) - 0x80); i = i + 3
        elseif i + 3 <= n then cp = (b1 - 0xF0) * 262144 + (s:byte(i + 1) - 0x80) * 4096 + (s:byte(i + 2) - 0x80) * 64 + (s:byte(i + 3) - 0x80); i = i + 4
        else cp = 0x3F; i = i + 1 end
        if cp >= 0x10000 then
            cp = cp - 0x10000
            codes[#codes + 1] = 0xD800 + math.floor(cp / 1024)
            codes[#codes + 1] = 0xDC00 + (cp % 1024)
        else
            codes[#codes + 1] = cp
        end
    end
    local buf = ffi.new("uint16_t[?]", #codes + 1)
    for k = 1, #codes do buf[k - 1] = codes[k] end
    buf[#codes] = 0
    return buf
end

local function vfog_read_file_fallback(path)
    if type(path) ~= "string" or #path == 0 then return nil end
    if type(io) == "table" and type(io.open) == "function" then
        local fh = io.open(path, "rb")
        if fh ~= nil then
            local s = fh:read("*a")
            fh:close()
            return s
        end
    end
    local got = nil
    pcall(function()
        local ok_f, ffi = pcall(require, "ffi")
        if not (ok_f and ffi ~= nil) then return end
        local api = _VFOG_PERSIST.w32_file_api
        if type(_G.VL3D_TEST_W32_API) == "table" then api = _G.VL3D_TEST_W32_API end
        if api == nil and ffi.os == "Windows" then
            api = false
            pcall(function()
                pcall(ffi.cdef, "void* GetModuleHandleA(const char*); void* GetProcAddress(void*, const char*);")
                local gmh = ffi.cast("void* (__stdcall *)(const char*)", ffi.C.GetModuleHandleA)
                local gpa = ffi.cast("void* (__stdcall *)(void*, const char*)", ffi.C.GetProcAddress)
                local k32 = gmh("kernel32.dll")
                if k32 ~= nil then
                    local p_cf = gpa(k32, "CreateFileW")
                    local p_rf = gpa(k32, "ReadFile")
                    local p_ch = gpa(k32, "CloseHandle")
                    if p_cf ~= nil and p_rf ~= nil and p_ch ~= nil then
                        api = {
                            CreateFileW = ffi.cast("intptr_t (__stdcall *)(const uint16_t*, uint32_t, uint32_t, void*, uint32_t, uint32_t, void*)", p_cf),
                            ReadFile    = ffi.cast("int (__stdcall *)(intptr_t, void*, uint32_t, uint32_t*, void*)", p_rf),
                            CloseHandle = ffi.cast("int (__stdcall *)(intptr_t)", p_ch),
                        }
                    end
                end
            end)
            _VFOG_PERSIST.w32_file_api = api
        end
        if not api then return end
        local wp = vfog_utf8_to_u16(ffi, path)
        local h = tonumber(api.CreateFileW(wp, 0x80000000, 7, nil, 3, 0x80, nil)) or -1
        if h == 0 or h == -1 then return end
        local buf = ffi.new("uint8_t[65536]")
        local rd = ffi.new("uint32_t[1]")
        if api.ReadFile(h, buf, 65536, rd, nil) ~= 0 and rd[0] > 0 then
            got = ffi.string(buf, rd[0])
        end
        api.CloseHandle(h)
    end)
    return got
end

local function vfog_detect_ui_lang()
    if type(_VFOG_PERSIST.ui_lang) == "string" then
        return _VFOG_PERSIST.ui_lang
    end
    local ui_lang = "ja"
    pcall(function()
        local paths = {}
        local sp = nil
        pcall(function() sp = obj.getinfo("script_path") end)
        if type(sp) == "string" and #sp > 0 then
            local sep = sp:sub(-1)
            if sep ~= "\\" and sep ~= "/" then sp = sp .. "/" end
            paths[#paths + 1] = sp .. "../aviutl2.ini"
            paths[#paths + 1] = sp .. "../../aviutl2.ini"
            paths[#paths + 1] = sp .. "..\\aviutl2.ini"
            paths[#paths + 1] = sp .. "..\\..\\aviutl2.ini"
        end
        local pdata = (type(os) == "table" and type(os.getenv) == "function") and os.getenv("ProgramData") or nil
        if type(pdata) == "string" and #pdata > 0 then
            paths[#paths + 1] = pdata .. "\\aviutl2\\aviutl2.ini"
        end
        paths[#paths + 1] = "C:\\ProgramData\\aviutl2\\aviutl2.ini"
        for i = 1, #paths do
            local content = vfog_read_file_fallback(paths[i])
            if type(content) == "string" and #content > 0 then
                    for line in content:gmatch("[^\r\n]+") do
                        local val = line:match("^%s*[Ll]anguage%s*=%s*(.-)%s*$")
                        if val ~= nil then
                            local s = val:match("^%s*(.-)%s*$") or ""
                            local low = s:lower()
                            if s == "" then
                                ui_lang = "ja"
                            elseif s:find("中", 1, true) or s:find("简", 1, true) or s:find("簡", 1, true) or s:find("繁", 1, true)
                                or low:find("chinese", 1, true) or low == "zh" or low == "cn" or low == "chs" or low == "cht"
                                or low:find("^zh[_%-%. ]") or low:find("[_%-%. ]zh$") or low:find("[_%-%. ]cn$") then
                                ui_lang = "zh"
                            elseif s:find("德", 1, true) or s:find("独", 1, true)
                                or low:find("deutsch", 1, true) or low:find("german", 1, true)
                                or low == "de" or low == "deu" or low == "ger"
                                or low:find("^de[_%-%. ]") or low:find("[_%-%. ]de$")
                                or low:find("[_%-%. ]de[_%-%. ]") then
                                ui_lang = "de"
                            elseif low == "default" or s:find("日本", 1, true) or low:find("japanese", 1, true) or low:find("japan", 1, true)
                                or low == "ja" or low == "jp" or low == "jpn"
                                or low:find("^ja[_%-%. ]") or low:find("[_%-%. ]ja$") or low:find("[_%-%. ]jp$") then
                                ui_lang = "ja"
                            else
                                ui_lang = "en"
                            end
                            break
                        end
                    end
                    break
                end
        end
    end)
    _VFOG_PERSIST.ui_lang = ui_lang
    return ui_lang
end

local P = {}
P.density     = density or 60
P.color       = fog_color or 0xa8bcd8
P.nscale      = noise_scale or 550
P.pattern     = pattern or 85
P.wind_x      = wind_x or 15
P.wind_y      = wind_y or 0
P.wind_z      = wind_z or 0
P.turbulence  = turbulence or 2
P.area_z      = area_z or 150
P.area_d      = area_d or 3200
P.spread      = spread or 135
P.height_fall = height_fall or 0
P.height_y    = height_y or 200
P.scatter     = scatter or 25
P.light_color = light_color or 0xdce6ff
P.hg_g        = hg_g or 0.45
P.light_x     = light_x or 0
P.light_y     = light_y or 0.25
P.light_z     = light_z or -1
P.scatter_source = tonumber(scatter_source) or 0
P.slices      = slices or 48
P.res_mode    = res_mode
if P.res_mode == nil then P.res_mode = 1 end
P.view_mode   = view_mode or 0
P.depth_fade  = depth_fade or 25
P.seed        = seed or 0
P.log_mode    = as_bool(log_mode, true)

local VFOG_LF = (function()
    local M = {}
    local MAGIC     = "VL3DLF\3\0"
    local HDR_BYTES = 264
    local GW        = 48
    local RAD_BYTES = 48 * 48 * 4 -- 9216
    local SH_BYTES  = 48 * 48 * 4 -- 9216
    local CAM_BYTES = 48 * 18 * 4 -- 3456
    local ok_ffi, ffi = pcall(require, "ffi")
    if not ok_ffi then ffi = nil end

    local function clamp(x, lo, hi)
        if x < lo then return lo elseif x > hi then return hi end
        return x
    end

    local function smoothstep(e0, e1, x)
        local t = (x - e0) / math.max(e1 - e0, 1e-6)
        if t <= 0.0 then return 0.0 elseif t >= 1.0 then return 1.0 end
        return t * t * (3.0 - 2.0 * t)
    end

    local function hash3(ix, iy, iz)
        local h = math.sin(ix * 127.1 + iy * 311.7 + iz * 74.7) * 43758.5453
        return h - math.floor(h)
    end

    local function vnoise3(x, y, z)
        local ix, iy, iz = math.floor(x), math.floor(y), math.floor(z)
        local fx, fy, fz = x - ix, y - iy, z - iz
        local ux = fx * fx * (3.0 - 2.0 * fx)
        local uy = fy * fy * (3.0 - 2.0 * fy)
        local uz = fz * fz * (3.0 - 2.0 * fz)
        local n000 = hash3(ix,     iy,     iz)
        local n100 = hash3(ix + 1, iy,     iz)
        local n010 = hash3(ix,     iy + 1, iz)
        local n110 = hash3(ix + 1, iy + 1, iz)
        local n001 = hash3(ix,     iy,     iz + 1)
        local n101 = hash3(ix + 1, iy,     iz + 1)
        local n011 = hash3(ix,     iy + 1, iz + 1)
        local n111 = hash3(ix + 1, iy + 1, iz + 1)
        local nx00 = n000 + (n100 - n000) * ux
        local nx10 = n010 + (n110 - n010) * ux
        local nx01 = n001 + (n101 - n001) * ux
        local nx11 = n011 + (n111 - n011) * ux
        local nxy0 = nx00 + (nx10 - nx00) * uy
        local nxy1 = nx01 + (nx11 - nx01) * uy
        return nxy0 + (nxy1 - nxy0) * uz
    end

    local function fbm3(x, y, z)
        local v1 = vnoise3(x, y, z)
        local v2 = vnoise3(x * 2.03 + 17.1, y * 2.03 + 31.7, z * 2.03 + 47.3)
        return v1 * 0.6667 + v2 * 0.3333
    end

    local function unpack_i32_le(s, pos)
        local b0, b1, b2, b3 = s:byte(pos, pos + 3)
        local u = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
        if u >= 2147483648 then u = u - 4294967296 end
        return u
    end

    local function unpack_f32_le(s, pos)
        local b0, b1, b2, b3 = s:byte(pos, pos + 3)
        local sign = (b3 >= 128) and -1.0 or 1.0
        local exp = (b3 % 128) * 2 + math.floor(b2 / 128)
        local mant = (b2 % 128) * 65536 + b1 * 256 + b0
        if exp == 0 then
            if mant == 0 then return 0.0 end
            return sign * math.ldexp(mant / 8388608.0, -126)
        elseif exp == 255 then
            return 0.0
        end
        return sign * math.ldexp(1.0 + mant / 8388608.0, exp - 127)
    end

    function M.scene_id()
        if type(obj.scene_id) == "number" then
            return math.floor(obj.scene_id + 0.5)
        end
        return 0
    end

    function M.scene_frame()
        local f = (type(obj.frame) == "number") and math.floor(obj.frame + 0.5) or 0
        local fs = (type(obj.frame_s) == "number") and math.floor(obj.frame_s + 0.5) or nil
        if fs == nil and type(obj.getvalue) == "function" then
            local ok_fs, v_fs = pcall(obj.getvalue, "frame_s")
            if ok_fs and type(v_fs) == "number" then fs = math.floor(v_fs + 0.5) end
        end
        local sf = (fs or 0) + f
        local fe = (type(obj.frame_e) == "number") and math.floor(obj.frame_e + 0.5) or nil
        if fe ~= nil and fs ~= nil and fe >= fs and sf > fe then
            sf = fe
        end
        return sf
    end

    function M.make_xform(ozm, ox0, oy0, oz0)
        local sx = ozm * ((type(obj.sx) == "number") and obj.sx or 1.0)
        local sy = ozm * ((type(obj.sy) == "number") and obj.sy or 1.0)
        local sz = ozm * ((type(obj.sz) == "number") and obj.sz or 1.0)
        local asp = (type(obj.aspect) == "number") and obj.aspect or 0.0
        if asp > 1e-6 then
            sy = sy * math.max(0.0, 1.0 - asp)
        elseif asp < -1e-6 then
            sx = sx * math.max(0.0, 1.0 + asp)
        end
        local cx = (type(obj.cx) == "number") and obj.cx or 0.0
        local cy = (type(obj.cy) == "number") and obj.cy or 0.0
        local cz = (type(obj.cz) == "number") and obj.cz or 0.0
        local rx = (type(obj.rx) == "number") and obj.rx or 0.0
        local ry = (type(obj.ry) == "number") and obj.ry or 0.0
        local rz = (type(obj.rz) == "number") and obj.rz or 0.0
        local tx = ox0 + ((type(obj.ox) == "number") and obj.ox or 0.0)
        local ty = oy0 + ((type(obj.oy) == "number") and obj.oy or 0.0)
        local tz = oz0 + ((type(obj.oz) == "number") and obj.oz or 0.0)
        local has_rot = (math.abs(rx) + math.abs(ry) + math.abs(rz)) > 1e-5
        local has_off = (math.abs(cx) + math.abs(cy) + math.abs(cz)) > 1e-5
            or math.abs(sx - ozm) > 1e-6 or math.abs(sy - ozm) > 1e-6 or math.abs(sz - ozm) > 1e-6
            or math.abs(tx - ox0) > 1e-6 or math.abs(ty - oy0) > 1e-6 or math.abs(tz - oz0) > 1e-6
        if not has_rot and not has_off then
            return { fast = true, ozm = ozm, tx = tx, ty = ty, tz = tz }
        end
        local d2r = math.pi / 180.0
        local ax, ay, az = rx * d2r, ry * d2r, rz * d2r
        local cxr, sxr = math.cos(ax), math.sin(ax)
        local cyr, syr = math.cos(ay), math.sin(ay)
        local czr, szr = math.cos(az), math.sin(az)
        -- AviUtl2 rot_xyz (X -> Y -> Z):
        -- v1 = Rx(v0), v2 = Ry(v1), v3 = Rz(v2)
        return {
            fast = false,
            sx = sx, sy = sy, sz = sz,
            cx = cx, cy = cy, cz = cz,
            tx = tx, ty = ty, tz = tz,
            m00 = cyr * czr,
            m01 = sxr * syr * czr - cxr * szr,
            m02 = cxr * syr * czr + sxr * szr,
            m10 = cyr * szr,
            m11 = sxr * syr * szr + cxr * czr,
            m12 = cxr * syr * szr - sxr * czr,
            m20 = -syr,
            m21 = sxr * cyr,
            m22 = cxr * cyr,
        }
    end

    function M.to_world(xf, lx, ly, lz)
        if xf.fast then
            local z = xf.ozm
            return lx * z + xf.tx, ly * z + xf.ty, lz * z + xf.tz
        end
        local x = (lx - xf.cx) * xf.sx
        local y = (ly - xf.cy) * xf.sy
        local z = (lz - xf.cz) * xf.sz
        return x * xf.m00 + y * xf.m01 + z * xf.m02 + xf.tx,
               x * xf.m10 + y * xf.m11 + z * xf.m12 + xf.ty,
               x * xf.m20 + y * xf.m21 + z * xf.m22 + xf.tz
    end

    function M.world_vec_to_local(xf, wx, wy, wz)
        if xf.fast then return wx, wy, wz end
        return wx * xf.m00 + wy * xf.m10 + wz * xf.m20,
               wx * xf.m01 + wy * xf.m11 + wz * xf.m21,
               wx * xf.m02 + wy * xf.m12 + wz * xf.m22
    end

    local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local B64_DEC_LUA = {}
    for i = 1, #B64_CHARS do B64_DEC_LUA[B64_CHARS:byte(i)] = i - 1 end
    local b64_dec_ffi = nil
    if ffi ~= nil then
        b64_dec_ffi = ffi.new("int16_t[256]")
        for i = 0, 255 do b64_dec_ffi[i] = -1 end
        for i = 1, #B64_CHARS do b64_dec_ffi[B64_CHARS:byte(i)] = i - 1 end
    end

    local function decode_b64(s, start_idx)
        local n = #s - start_idx + 1
        if n < 4 then return nil end
        if ffi ~= nil and b64_dec_ffi ~= nil then
            local max_out = math.floor(n / 4) * 3 + 4
            local out = ffi.new("uint8_t[?]", max_out)
            local sp = ffi.cast("const uint8_t*", s) + (start_idx - 1)
            local lut = b64_dec_ffi
            local si, di = 0, 0
            while si + 3 < n do
                local c0 = lut[sp[si]]
                local c1 = lut[sp[si + 1]]
                local b2 = sp[si + 2]
                local b3 = sp[si + 3]
                if c0 < 0 or c1 < 0 then break end
                local c2 = (b2 == 61) and 0 or lut[b2]
                local c3 = (b3 == 61) and 0 or lut[b3]
                if c2 < 0 or c3 < 0 then break end
                local v = c0 * 262144 + c1 * 4096 + c2 * 64 + c3
                out[di] = math.floor(v / 65536) % 256
                di = di + 1
                if b2 ~= 61 then
                    out[di] = math.floor(v / 256) % 256
                    di = di + 1
                    if b3 ~= 61 then
                        out[di] = v % 256
                        di = di + 1
                    end
                end
                si = si + 4
            end
            return ffi.string(out, di)
        end
        local chunks = {}
        local ci = 0
        local i = start_idx
        local len_s = #s
        while i + 3 <= len_s do
            local a0, a1, a2, a3 = s:byte(i, i + 3)
            local c0, c1 = B64_DEC_LUA[a0], B64_DEC_LUA[a1]
            if c0 == nil or c1 == nil then break end
            local c2 = (a2 == 61) and 0 or B64_DEC_LUA[a2]
            local c3 = (a3 == 61) and 0 or B64_DEC_LUA[a3]
            if c2 == nil or c3 == nil then break end
            local v = c0 * 262144 + c1 * 4096 + c2 * 64 + c3
            local o0 = math.floor(v / 65536) % 256
            if a2 == 61 then
                ci = ci + 1; chunks[ci] = string.char(o0)
            elseif a3 == 61 then
                ci = ci + 1; chunks[ci] = string.char(o0, math.floor(v / 256) % 256)
            else
                ci = ci + 1; chunks[ci] = string.char(o0, math.floor(v / 256) % 256, v % 256)
            end
            i = i + 4
        end
        return table.concat(chunks)
    end

    local function decode_slot(raw_slot, want_sid, cur_frame)
        if type(raw_slot) ~= "string" or #raw_slot < 16 then return nil end
        local blob = raw_slot
        if raw_slot:sub(1, 8) == "VL3DB64:" then
            blob = decode_b64(raw_slot, 9)
        end
        if type(blob) ~= "string" or #blob < HDR_BYTES then return nil end
        if blob:sub(1, 8) ~= MAGIC then return nil end
        local iv, fv, u8_ptr
        if ffi ~= nil then
            u8_ptr = ffi.cast("const uint8_t*", blob)
            local ip = ffi.cast("const int32_t*", u8_ptr + 8)
            iv = {}
            for i = 1, 8 do iv[i] = tonumber(ip[i - 1]) or 0 end
        else
            iv = {}
            for i = 1, 8 do iv[i] = unpack_i32_le(blob, 9 + (i - 1) * 4) end
        end

        local sid = iv[1]
        local sframe = iv[3]
        if sid ~= want_sid then return nil end
        if math.abs(cur_frame - sframe) > 1 then return nil end

        local flags = iv[6]
        local function has_bit(b) return (math.floor(flags / b) % 2) == 1 end
        local has_rad = has_bit(1)
        local has_sh  = has_bit(2)
        local has_cam = has_bit(4)
        local has_ext_cam = has_bit(512)
        local hdr_b = has_ext_cam and 320 or HDR_BYTES
        local n_flt = has_ext_cam and 70 or 56
        local need_len = hdr_b
            + (has_rad and RAD_BYTES or 0)
            + (has_sh  and SH_BYTES  or 0)
            + (has_cam and CAM_BYTES or 0)
        if #blob < need_len then return nil end

        if ffi ~= nil then
            local fp = ffi.cast("const float*", u8_ptr + 40)
            fv = {}
            for i = 1, n_flt do fv[i] = tonumber(fp[i - 1]) or 0.0 end
        else
            fv = {}
            for i = 1, n_flt do fv[i] = unpack_f32_le(blob, 41 + (i - 1) * 4) end
        end

        local off_rad = hdr_b
        local off_sh  = off_rad + (has_rad and RAD_BYTES or 0)
        local off_cam = off_sh  + (has_sh  and SH_BYTES  or 0)

        return {
            blob    = blob,
            u8      = u8_ptr,
            layer   = iv[2],
            kind    = iv[5],
            has_rad = has_rad,
            has_sh  = has_sh,
            has_cam = has_cam,
            is_spot = has_bit(8),
            fog_on  = has_bit(16),
            occ3d_front_only = has_bit(32),
            is_ortho_cam     = has_bit(64),
            has_cam_3d_light = has_bit(128),
            cam_light_is_pos = has_bit(256),
            has_ext_cam      = has_ext_cam,
            off_rad = off_rad,
            off_sh  = off_sh,
            off_cam = off_cam,
            wx = fv[1], wy = fv[2], wz = fv[3],
            Wrx = fv[4], Wry = fv[5], Wrz = fv[6],
            Wdx = fv[7], Wdy = fv[8], Wdz = fv[9],
            Wnx = fv[10], Wny = fv[11], Wnz = fv[12],
            sx_p = fv[13], sy_p = fv[14], sz_p = fv[15],
            inv_2Hx = fv[16], inv_2Hy = fv[17],
            dS_wn = fv[18], u_wn = fv[19],
            L_tot = fv[20], k_dec = fv[21], inv_end = fv[22],
            u0_b = fv[23], u1_b = fv[24], v0_b = fv[25], v1_b = fv[26],
            su0 = fv[27], su1 = fv[28], sv0 = fv[29], sv1 = fv[30],
            gain_r = fv[31], gain_g = fv[32], gain_b = fv[33],
            min_x = fv[34], min_y = fv[35], min_z = fv[36],
            max_x = fv[37], max_y = fv[38], max_z = fv[39],
            cl_px = fv[40], cl_py = fv[41], cl_pz = fv[42],
            cl_dx = fv[43], cl_dy = fv[44], cl_dz = fv[45],
            cos_in_sp = fv[46], cos_out_sp = fv[47], att_k_sp = fv[48],
            cam_zmax = fv[49], z_win_cam = fv[50], sh_soft_t = fv[51],
            fog_amt = fv[52], inv_fscale = fv[53],
            wox = fv[54], woy = fv[55], woz = fv[56],
            cam_x = has_ext_cam and fv[57] or 0.0,
            cam_y = has_ext_cam and fv[58] or 0.0,
            cam_z = has_ext_cam and fv[59] or -1024.0,
            cam_fx = has_ext_cam and fv[60] or 0.0,
            cam_fy = has_ext_cam and fv[61] or 0.0,
            cam_fz = has_ext_cam and fv[62] or 1.0,
            cam_rx = has_ext_cam and fv[63] or 1.0,
            cam_ry = has_ext_cam and fv[64] or 0.0,
            cam_rz = has_ext_cam and fv[65] or 0.0,
            cam_dx = has_ext_cam and fv[66] or 0.0,
            cam_dy = has_ext_cam and fv[67] or 1.0,
            cam_dz = has_ext_cam and fv[68] or 0.0,
            cam_focal = has_ext_cam and fv[69] or 1024.0,
            host_unlit = has_ext_cam and fv[70] or 1.0,
        }
    end

    function M.collect(enable)
        if not enable then return {}, "OFF" end
        if global == nil then return {}, "WAIT" end
        local sid = M.scene_id()
        local cur_f = M.scene_frame()
        local idx_key = "VL3D_LF_IDX:" .. tostring(sid)
        local ok_i, raw = pcall(function() return global[idx_key] end)
        if not ok_i or raw == nil then return {}, "WAIT" end
        if type(raw) ~= "string" or raw == "" then return {}, "IDLE" end
        local out = {}
        local seen = {}
        for tok in raw:gmatch("(%d+)") do
            local ln = tonumber(tok)
            if ln ~= nil and ln > 0 and not seen[ln] then
                seen[ln] = true
                local sk = "VL3D_LF:" .. tostring(sid) .. ":" .. tostring(math.floor(ln))
                local ok_b, blob = pcall(function() return global[sk] end)
                if ok_b and type(blob) == "string" and #blob >= HDR_BYTES then
                    local em = decode_slot(blob, sid, cur_f)
                    if em ~= nil then out[#out + 1] = em end
                end
            end
        end
        return out, (#out > 0) and "ON" or "IDLE"
    end

    local function read_rgba01(em, base_off, w, h, ix, iy)
        if ix < 0 then ix = 0 elseif ix >= w then ix = w - 1 end
        if iy < 0 then iy = 0 elseif iy >= h then iy = h - 1 end
        local off = base_off + (iy * w + ix) * 4
        local r, g, b, a
        if em.u8 ~= nil then
            local p = em.u8
            r, g, b, a = p[off], p[off + 1], p[off + 2], p[off + 3]
        else
            r, g, b, a = em.blob:byte(off + 1, off + 4)
        end
        local k = 1.0 / 255.0
        return r * k, g * k, b * k, a * k
    end

    local function sample_rad_bilerp(em, nu, nv)
        local fx = clamp(nu, 0.0, 1.0) * GW - 0.5
        local fy = clamp(nv, 0.0, 1.0) * GW - 0.5
        local x0 = math.floor(fx)
        local y0 = math.floor(fy)
        local tx = fx - x0
        local ty = fy - y0
        local r00, g00, b00, a00 = read_rgba01(em, em.off_rad, GW, GW, x0,     y0)
        local r10, g10, b10, a10 = read_rgba01(em, em.off_rad, GW, GW, x0 + 1, y0)
        local r01, g01, b01, a01 = read_rgba01(em, em.off_rad, GW, GW, x0,     y0 + 1)
        local r11, g11, b11, a11 = read_rgba01(em, em.off_rad, GW, GW, x0 + 1, y0 + 1)
        local w00 = (1.0 - tx) * (1.0 - ty)
        local w10 = tx * (1.0 - ty)
        local w01 = (1.0 - tx) * ty
        local w11 = tx * ty
        local pr = r00 * w00 + r10 * w10 + r01 * w01 + r11 * w11
        local pg = g00 * w00 + g10 * w10 + g01 * w01 + g11 * w11
        local pb = b00 * w00 + b10 * w10 + b01 * w01 + b11 * w11
        local pa = a00 * w00 + a10 * w10 + a01 * w01 + a11 * w11
        return pr, pg, pb, pa
    end

    local function eval_sh_corner(em, ix, iy, t_ray)
        local r01, g01, cov, av = read_rgba01(em, em.off_sh, GW, GW, ix, iy)
        if av < 0.5 or cov <= 0.004 then return 1.0 end
        local hi = math.floor(r01 * 255.0 + 0.5)
        local lo = math.floor(g01 * 255.0 + 0.5)
        local tocc = (hi * 256.0 + lo) * (1.0 / 65535.0) * em.L_tot
        local soft = em.sh_soft_t
        return 1.0 - cov * smoothstep(tocc - soft * 0.35, tocc + soft, t_ray)
    end

    local function sample_sh_vis(em, u, v, t_ray)
        if u < em.su0 or u > em.su1 or v < em.sv0 or v > em.sv1 then return 1.0 end
        local nu = (u - em.su0) / math.max(em.su1 - em.su0, 1e-5)
        local nv = (v - em.sv0) / math.max(em.sv1 - em.sv0, 1e-5)
        local fx = clamp(nu, 0.0, 1.0) * GW - 0.5
        local fy = clamp(nv, 0.0, 1.0) * GW - 0.5
        local x0 = math.floor(fx)
        local y0 = math.floor(fy)
        local tx = fx - x0
        local ty = fy - y0
        local v00 = eval_sh_corner(em, x0,     y0,     t_ray)
        local v10 = eval_sh_corner(em, x0 + 1, y0,     t_ray)
        local v01 = eval_sh_corner(em, x0,     y0 + 1, t_ray)
        local v11 = eval_sh_corner(em, x0 + 1, y0 + 1, t_ray)
        local vx0 = v00 + (v10 - v00) * tx
        local vx1 = v01 + (v11 - v01) * tx
        return vx0 + (vx1 - vx0) * ty
    end

    local function eval_cam_corner(em, ix, iy, zc_snow)
        local r01, g01, cov, av = read_rgba01(em, em.off_cam, GW, 18, ix, iy)
        if av < 0.5 or cov <= 0.004 then return 1.0 end
        local hi = math.floor(r01 * 255.0 + 0.5)
        local lo = math.floor(g01 * 255.0 + 0.5)
        local z_fg = (hi * 256.0 + lo) * (1.0 / 65535.0) * em.cam_zmax
        if em.occ3d_front_only and z_fg >= em.z_win_cam - 2.0 then
            return 1.0
        end
        return 1.0 - cov * smoothstep(z_fg - 6.0, z_fg + 14.0, zc_snow)
    end

    local function sample_cam_vis(em, su, sv, zc_snow)
        if su < 0.0 or su > 1.0 or sv < 0.0 or sv > 1.0 then return 1.0 end
        local fx = su * GW - 0.5
        local fy = sv * 18.0 - 0.5
        local x0 = math.floor(fx)
        local y0 = math.floor(fy)
        local tx = fx - x0
        local ty = fy - y0
        local v00 = eval_cam_corner(em, x0,     y0,     zc_snow)
        local v10 = eval_cam_corner(em, x0 + 1, y0,     zc_snow)
        local v01 = eval_cam_corner(em, x0,     y0 + 1, zc_snow)
        local v11 = eval_cam_corner(em, x0 + 1, y0 + 1, zc_snow)
        local vx0 = v00 + (v10 - v00) * tx
        local vx1 = v01 + (v11 - v01) * tx
        return vx0 + (vx1 - vx0) * ty
    end

    function M.sample(emitters, wx, wy, wz, dx_c, dy_c, dz_c, zc_snow, r_x, r_y, r_z, u_x, u_y, u_z, focal_d, scr_w, scr_h)
        local acc_r, acc_g, acc_b = 0.0, 0.0, 0.0
        local acc_dx, acc_dy, acc_dz, acc_dw = 0.0, 0.0, 0.0, 0.0
        local su_c, sv_c = nil, nil
        for ei = 1, #emitters do
            local em = emitters[ei]
            if wx >= em.min_x and wx <= em.max_x
                and wy >= em.min_y and wy <= em.max_y
                and wz >= em.min_z and wz <= em.max_z then
                local dwx, dwy, dwz = wx - em.wx, wy - em.wy, wz - em.wz
                local d_wn = dwx * em.Wnx + dwy * em.Wny + dwz * em.Wnz
                if d_wn < -2.0 then
                    local spot_f = 1.0
                    local ok_ray = true
                    if em.is_spot then
                        local vx, vy, vz = wx - em.cl_px, wy - em.cl_py, wz - em.cl_pz
                        local ax = vx * em.cl_dx + vy * em.cl_dy + vz * em.cl_dz
                        local d2 = vx * vx + vy * vy + vz * vz
                        if ax <= 3.0 or d2 <= 1e-6 then
                            ok_ray = false
                        else
                            local dist_sp = math.sqrt(d2)
                            if dist_sp >= em.L_tot then
                                ok_ray = false
                            else
                                local cos_sp = ax / dist_sp
                                if cos_sp <= em.cos_out_sp then
                                    ok_ray = false
                                else
                                    local dr = dist_sp * (1.0 / 800.0)
                                    spot_f = smoothstep(em.cos_out_sp, em.cos_in_sp, cos_sp) / (1.0 + em.att_k_sp * dr * dr)
                                end
                            end
                        end
                    end

                    if ok_ray then
                        local qx, qy, qz, t_ray
                        local g_div = 1.0
                        if em.kind == 0 then
                            t_ray = d_wn / em.u_wn
                            if t_ray <= 0.0 or t_ray >= em.L_tot then
                                ok_ray = false
                            else
                                qx = wx - em.sx_p * t_ray
                                qy = wy - em.sy_p * t_ray
                                qz = wz - em.sz_p * t_ray
                            end
                        elseif em.kind == 1 then
                            local dvx, dvy, dvz = wx - em.sx_p, wy - em.sy_p, wz - em.sz_p
                            local den = dvx * em.Wnx + dvy * em.Wny + dvz * em.Wnz
                            if math.abs(den) <= 1e-4 then
                                ok_ray = false
                            else
                                local alpha = em.dS_wn / den
                                if alpha <= 0.0 or alpha >= 1.0 then
                                    ok_ray = false
                                else
                                    local vlen = math.sqrt(dvx * dvx + dvy * dvy + dvz * dvz)
                                    t_ray = math.abs(1.0 - alpha) * vlen
                                    if t_ray >= em.L_tot then
                                        ok_ray = false
                                    else
                                        qx = em.sx_p + dvx * alpha
                                        qy = em.sy_p + dvy * alpha
                                        qz = em.sz_p + dvz * alpha
                                    end
                                end
                            end
                        else
                            local dvx, dvy, dvz = wx - em.sx_p, wy - em.sy_p, wz - em.sz_p
                            local den = dvx * em.Wnx + dvy * em.Wny + dvz * em.Wnz
                            if math.abs(den) <= 1e-4 then
                                ok_ray = false
                            else
                                local alpha = em.dS_wn / den
                                if alpha >= 0.0 and alpha <= 1.0 then
                                    ok_ray = false
                                else
                                    local vlen = math.sqrt(dvx * dvx + dvy * dvy + dvz * dvz)
                                    t_ray = math.abs(1.0 - alpha) * vlen
                                    if t_ray >= em.L_tot then
                                        ok_ray = false
                                    else
                                        qx = em.sx_p + dvx * alpha
                                        qy = em.sy_p + dvy * alpha
                                        qz = em.sz_p + dvz * alpha
                                        local conc = math.min(9.0, math.max(1.0, math.abs(alpha)))
                                        g_div = math.min(6.5, conc ^ 1.15)
                                    end
                                end
                            end
                        end

                        if ok_ray then
                            local dqx, dqy, dqz = qx - em.wx, qy - em.wy, qz - em.wz
                            local u = 0.5 + (dqx * em.Wrx + dqy * em.Wry + dqz * em.Wrz) * em.inv_2Hx
                            local v = 0.5 + (dqx * em.Wdx + dqy * em.Wdy + dqz * em.Wdz) * em.inv_2Hy
                            if em.is_spot then
                                u = clamp(u, 0.001, 0.999)
                                v = clamp(v, 0.001, 0.999)
                            elseif u < em.u0_b or u > em.u1_b or v < em.v0_b or v > em.v1_b then
                                ok_ray = false
                            end

                            if ok_ray then
                                local sr, sg, sb, sa = 1.0, 1.0, 1.0, 1.0
                                if em.has_rad then
                                    local nu = (u - em.u0_b) / math.max(em.u1_b - em.u0_b, 1e-5)
                                    local nv = (v - em.v0_b) / math.max(em.v1_b - em.v0_b, 1e-5)
                                    sr, sg, sb, sa = sample_rad_bilerp(em, nu, nv)
                                end
                                if sa > 0.004 then
                                    local sh_vis = em.has_sh and sample_sh_vis(em, u, v, t_ray) or 1.0
                                    if sh_vis > 0.004 then
                                        local fg_vis = 1.0
                                        if em.has_cam then
                                            if su_c == nil then
                                                local rx_c = dx_c * r_x + dy_c * r_y + dz_c * r_z
                                                local dy_s = -(dx_c * u_x + dy_c * u_y + dz_c * u_z)
                                                if em.is_ortho_cam then
                                                    su_c = 0.5 + rx_c / scr_w
                                                    sv_c = 0.5 + dy_s / scr_h
                                                elseif zc_snow > 1.0 then
                                                    local k_p = focal_d / zc_snow
                                                    su_c = 0.5 + (rx_c * k_p) / scr_w
                                                    sv_c = 0.5 + (dy_s * k_p) / scr_h
                                                else
                                                    su_c, sv_c = -1.0, -1.0
                                                end
                                            end
                                            fg_vis = sample_cam_vis(em, su_c, sv_c, zc_snow)
                                        end
                                        if fg_vis > 0.004 then
                                            local att = math.exp(-em.k_dec * t_ray) * smoothstep(0.0, 1.0, (em.L_tot - t_ray) * em.inv_end)
                                            local fog_f = 1.0
                                            if em.fog_on then
                                                local n = fbm3((wx + em.wox) * em.inv_fscale, (wy + em.woy) * em.inv_fscale, (wz + em.woz) * em.inv_fscale)
                                                fog_f = 1.0 + (smoothstep(0.16, 0.84, n) - 1.0) * em.fog_amt
                                            end
                                            local w_tot = g_div * spot_f * att * fog_f * sh_vis * fg_vis
                                            local cr = sr * em.gain_r * w_tot
                                            local cg = sg * em.gain_g * w_tot
                                            local cb = sb * em.gain_b * w_tot
                                            acc_r = acc_r + cr
                                            acc_g = acc_g + cg
                                            acc_b = acc_b + cb
                                            local dx_l, dy_l, dz_l = wx - qx, wy - qy, wz - qz
                                            local dl_l = math.sqrt(dx_l * dx_l + dy_l * dy_l + dz_l * dz_l)
                                            if dl_l > 1e-5 then
                                                local weight_l = math.max(cr, cg, cb)
                                                acc_dx = acc_dx + dx_l * (weight_l / dl_l)
                                                acc_dy = acc_dy + dy_l * (weight_l / dl_l)
                                                acc_dz = acc_dz + dz_l * (weight_l / dl_l)
                                                acc_dw = acc_dw + weight_l
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        local dl = math.sqrt(acc_dx * acc_dx + acc_dy * acc_dy + acc_dz * acc_dz)
        if dl > 1e-6 then
            return acc_r, acc_g, acc_b, acc_dx / dl, acc_dy / dl, acc_dz / dl, acc_dw
        end
        return acc_r, acc_g, acc_b, 0.0, 0.0, 0.0, 0.0
    end

    return M
end)()

local function fog_frame()

    ------------------------------------------------------------
    -- パラメータ整理
    ------------------------------------------------------------
    local n_sl = math.floor(P.slices + 0.5)
    if n_sl < 8 then n_sl = 8 elseif n_sl > 64 then n_sl = 64 end

    local dens = P.density / 100
    if dens < 0 then dens = 0 elseif dens > 1 then dens = 1 end

    local base_alpha = obj.alpha or 1
    if type(base_alpha) ~= "number" then base_alpha = 1 end
    if base_alpha < 0 then base_alpha = 0 elseif base_alpha > 1 then base_alpha = 1 end

    -- 濃さ 0 または不透明度 0 のときは何も描かず終了（自動描画も抑止）
    if dens <= 0.0005 or base_alpha <= 0.0005 then
        pcall(function() obj.setoption("draw_state", true) end)
        return
    end

    local pv = P.pattern / 100
    if pv < 0 then pv = 0 elseif pv > 1 then pv = 1 end

    local dfade = P.depth_fade / 100
    if dfade < 0 then dfade = 0 elseif dfade > 1 then dfade = 1 end

    local col_r = math.floor(P.color / 0x10000) % 0x100 / 255
    local col_g = math.floor(P.color / 0x100) % 0x100 / 255
    local col_b = P.color % 0x100 / 255

    local lc_r = math.floor(P.light_color / 0x10000) % 0x100 / 255
    local lc_g = math.floor(P.light_color / 0x100) % 0x100 / 255
    local lc_b = P.light_color % 0x100 / 255

    local scat = P.scatter / 100
    if scat < 0 then scat = 0 elseif scat > 1 then scat = 1 end
    local scat_k = scat * 0.20

    local g_hg = P.hg_g
    if g_hg < -0.9 then g_hg = -0.9 elseif g_hg > 0.9 then g_hg = 0.9 end

    local ldx, ldy, ldz = P.light_x, P.light_y, P.light_z
    local ldl = math.sqrt(ldx * ldx + ldy * ldy + ldz * ldz)
    if ldl > 1e-6 then
        ldx, ldy, ldz = ldx / ldl, ldy / ldl, ldz / ldl
    else
        ldx, ldy, ldz = 0, 0, -1
    end

    local hf = P.height_fall / 100
    if hf < 0 then hf = 0 elseif hf > 1 then hf = 1 end
    local h_fall_k = hf * hf * 0.016

    local obj_x = type(obj.x) == "number" and obj.x or 0
    local obj_y = type(obj.y) == "number" and obj.y or 0
    local obj_z = type(obj.z) == "number" and obj.z or 0
    local zoom = type(obj.zoom) == "number" and obj.zoom or 1
    if zoom < 1e-6 then zoom = 1 end

    ------------------------------------------------------------
    -- スクリーン解像度（obj.w ではなく obj.screen_w を使う！）
    ------------------------------------------------------------
    local scr_w = type(obj.screen_w) == "number" and obj.screen_w or 0
    local scr_h = type(obj.screen_h) == "number" and obj.screen_h or 0
    if scr_w < 1 then scr_w = (type(obj.w) == "number" and obj.w >= 64) and obj.w or 1920 end
    if scr_h < 1 then scr_h = (type(obj.h) == "number" and obj.h >= 64) and obj.h or 1080 end

    ------------------------------------------------------------
    -- カメラ（前方 f・画面右 r・画面下 d_vec）と編集用視点の判定
    ------------------------------------------------------------
    local cam_mode = 1
    pcall(function()
        local cm = obj.getoption("camera_mode")
        if type(cm) == "number" then cam_mode = cm end
    end)

    local cam = nil
    pcall(function() cam = obj.getoption("camera_param") end)
    local edit_cam_live = false
    if cam_mode == 2 and cam == nil then
        local ecam = vfog_try_edit_camera()
        if type(ecam) == "table" then
            cam = ecam
            edit_cam_live = true
        end
    end

    local cam_x, cam_y, cam_z = 0, 0, -1024
    local tx, ty, tz = 0, 0, 0
    local focal_d = 1024
    local f_x, f_y, f_z = 0, 0, 1
    local r_x, r_y, r_z = 1, 0, 0
    local d_x, d_y, d_z = 0, 1, 0     -- 画面の下方向（AviUtl は +Y が下）

    if cam ~= nil then
        cam_x = cam.x or 0
        cam_y = cam.y or 0
        cam_z = cam.z or -1024
        tx = cam.tx or 0
        ty = cam.ty or 0
        tz = cam.tz or 0
        if type(cam.d) == "number" and cam.d > 1 then focal_d = cam.d end

        local vx, vy, vz = tx - cam_x, ty - cam_y, tz - cam_z
        local vl = math.sqrt(vx * vx + vy * vy + vz * vz)
        if vl > 1e-6 then f_x, f_y, f_z = vx / vl, vy / vl, vz / vl end

        -- カメラの上方向ベクトル（既定 0,-1,0）から右手系で「画面右 r = f × up」を作る
        local up_x, up_y, up_z = 0, -1, 0
        if type(cam.ux) == "number" then up_x, up_y, up_z = cam.ux, cam.uy, cam.uz end
        if up_x * up_x + up_y * up_y + up_z * up_z < 1e-9 then up_x, up_y, up_z = 0, -1, 0 end

        r_x = f_y * up_z - f_z * up_y
        r_y = f_z * up_x - f_x * up_z
        r_z = f_x * up_y - f_y * up_x
        local rl = math.sqrt(r_x * r_x + r_y * r_y + r_z * r_z)
        if rl > 1e-6 then
            r_x, r_y, r_z = r_x / rl, r_y / rl, r_z / rl
        else
            r_x, r_y, r_z = 1, 0, 0
        end

        -- 画面の下方向 d_vec = f × r（既定カメラで +Y = 0,+1,0 となり UV の縦方向と完全一致）
        d_x = f_y * r_z - f_z * r_y
        d_y = f_z * r_x - f_x * r_z
        d_z = f_x * r_y - f_y * r_x
        local dl = math.sqrt(d_x * d_x + d_y * d_y + d_z * d_z)
        if dl > 1e-6 then d_x, d_y, d_z = d_x / dl, d_y / dl, d_z / dl end

        if type(cam.rz) == "number" and math.abs(cam.rz) > 1e-5 then
            local cr = math.cos(math.rad(cam.rz))
            local sr = math.sin(math.rad(cam.rz))
            local nr_x, nr_y, nr_z = r_x * cr + d_x * sr, r_y * cr + d_y * sr, r_z * cr + d_z * sr
            local nd_x, nd_y, nd_z = -r_x * sr + d_x * cr, -r_y * sr + d_y * cr, -r_z * sr + d_z * cr
            r_x, r_y, r_z = nr_x, nr_y, nr_z
            d_x, d_y, d_z = nd_x, nd_y, nd_z
        end
    end

    local half_w = scr_w * 0.5 / focal_d
    local half_h = scr_h * 0.5 / focal_d

    -- プレビューの「編集用視点（緑のカメラアイコン ON）」:
    -- VL3DBridge.aux2 でライブ編集カメラを取得できた場合は通常の視錐台/球体世界座標描画を使用。
    -- 単体動作で cam == nil かつ高さ減衰（h_fall_k > 0）が有効な場合は billboard=3 で世界 Y 軸が
    -- 傾くのを防ぐため世界座標基底（billboard=0）を維持し、等方霧（h_fall_k == 0）のみ billboard=3 を使用する。
    local use_sphere = (P.view_mode == 2) or (P.view_mode == 0 and cam_mode == 2 and not edit_cam_live)
    local use_edit_billboard = use_sphere and (cam_mode == 2) and (cam == nil) and (h_fall_k <= 0.0)

    local t_now = type(obj.time) == "number" and obj.time or 0
    local wox = P.wind_x * t_now + P.seed * 37.13
    local woy = P.wind_y * t_now + P.seed * 71.77
    local woz = P.wind_z * t_now + P.seed * 113.31
    local ns = P.nscale < 20 and 20 or P.nscale
    local anim_t = t_now * P.turbulence * 0.12

    local near_z = P.area_z < 10 and 10 or P.area_z
    local depth_span = P.area_d < 50 and 50 or P.area_d
    local sp = P.spread / 100
    if sp < 1.02 then sp = 1.02 end

    ------------------------------------------------------------
    -- アトラス解像度（8×8 = 最大 64 スライスを 1 枚の GPU テクスチャに一括生成）
    ------------------------------------------------------------
    local max_w, max_h = 4096, 4096
    pcall(function()
        local mw, mh = obj.getinfo("image_max")
        if type(mw) == "number" and mw >= 512 then max_w = mw end
        if type(mh) == "number" and mh >= 512 then max_h = mh end
    end)

    local TILES_X = 8
    local ATLAS = (P.res_mode == 0) and 1024 or 2048
    if ATLAS > max_w then ATLAS = max_w end
    if ATLAS > max_h then ATLAS = max_h end
    ATLAS = math.floor(ATLAS / TILES_X) * TILES_X
    if ATLAS < 512 then ATLAS = 512 end
    local TILE = ATLAS / TILES_X
    local PAD = 2.0

    local orig_x, orig_y, orig_z
    local start_s, dz, hw_k, hh_k, sigma_dz, mode_flag

    if not use_sphere then
        orig_x, orig_y, orig_z = cam_x, cam_y, cam_z
        start_s = near_z
        dz = depth_span / n_sl
        hw_k = sp * half_w
        hh_k = sp * half_h
        sigma_dz = dens * 0.00052 * dz
        mode_flag = 0
    else
        orig_x, orig_y, orig_z = tx, ty, tz
        local r_vol = depth_span * 1.35
        if r_vol < 4200 then r_vol = 4200 end
        local ry_vol = r_vol * 0.82
        start_s = -r_vol
        dz = (2.0 * r_vol) / n_sl
        hw_k = r_vol
        hh_k = ry_vol
        sigma_dz = dens * 0.00038 * dz
        mode_flag = 1
    end

    ------------------------------------------------------------
    -- 1) GPU ピクセルシェーダーで全スライスを一括レンダリング
    ------------------------------------------------------------
    local consts = {
        TILE, TILES_X, n_sl, PAD,
        orig_x, orig_y, orig_z, start_s,
        f_x, f_y, f_z, dz,
        r_x, r_y, r_z, hw_k,
        d_x, d_y, d_z, hh_k,
        wox, woy, woz, 1.0 / ns,
        col_r, col_g, col_b, sigma_dz,
        pv, dfade, mode_flag, anim_t,
        ldx, ldy, ldz, g_hg,
        lc_r * scat_k, lc_g * scat_k, lc_b * scat_k, h_fall_k,
        P.height_y, 1.0 / sp, 0.85, 0,
        cam_x, cam_y, cam_z, 0
    }

    local lf_emitters, lf_state = {}, "OFF"
    if P.scatter_source == 1 then lf_emitters, lf_state = VFOG_LF.collect(true) end
    local lf_active = (P.scatter_source == 1 and #lf_emitters > 0)
    consts[48] = lf_active and 1.0 or 0.0

    local LF_GRID = 4
    local LF_SAMPLES = 64 * LF_GRID * LF_GRID
    local lf_colors, lf_dirs = {}, {}
    if lf_active then
        for si = 0, n_sl - 1 do
            local z = start_s + (si + 0.5) * dz
            local rad_s = 0.0
            if use_sphere then
                local sq = hw_k * hw_k - z * z
                rad_s = sq > 0 and math.sqrt(sq) or 0.0
                if rad_s < 200.0 then rad_s = 200.0 end
            end
            for gy = 0, LF_GRID - 1 do
                for gx = 0, LF_GRID - 1 do
                    local lu = ((gx + 0.5) / LF_GRID) * 2.0 - 1.0
                    local lv = ((gy + 0.5) / LF_GRID) * 2.0 - 1.0
                    local wx, wy, wz
                    if use_sphere then
                        local lx = lu * rad_s
                        local ly = lv * rad_s * (hh_k / math.max(hw_k, 1.0))
                        wx = orig_x + f_x * z + r_x * lx + d_x * ly
                        wy = orig_y + f_y * z + r_y * lx + d_y * ly
                        wz = orig_z + f_z * z + r_z * lx + d_z * ly
                    else
                        wx = orig_x + f_x * z + r_x * (lu * hw_k * z) + d_x * (lv * hh_k * z)
                        wy = orig_y + f_y * z + r_y * (lu * hw_k * z) + d_y * (lv * hh_k * z)
                        wz = orig_z + f_z * z + r_z * (lu * hw_k * z) + d_z * (lv * hh_k * z)
                    end
                    local dx_c, dy_c, dz_c = wx - cam_x, wy - cam_y, wz - cam_z
                    local zc = dx_c * f_x + dy_c * f_y + dz_c * f_z
                    local idx = si * LF_GRID * LF_GRID + gy * LF_GRID + gx + 1
                    local ir, ig, ib, idirx, idiry, idirz, strength = VFOG_LF.sample(
                        lf_emitters, wx, wy, wz,
                        dx_c, dy_c, dz_c, zc,
                        r_x, r_y, r_z, -d_x, -d_y, -d_z,
                        focal_d, scr_w, scr_h
                    )
                    local cscale = scat_k
                    lf_colors[idx] = { ir * cscale, ig * cscale, ib * cscale, strength }
                    lf_dirs[idx] = { idirx, idiry, idirz, 0.0 }
                end
            end
        end
    end
    local ci = #consts
    for i = 1, LF_SAMPLES do
        local c = lf_colors[i]
        ci = ci + 1; consts[ci] = c ~= nil and c[1] or 0.0
        ci = ci + 1; consts[ci] = c ~= nil and c[2] or 0.0
        ci = ci + 1; consts[ci] = c ~= nil and c[3] or 0.0
        ci = ci + 1; consts[ci] = c ~= nil and c[4] or 0.0
    end
    for i = 1, LF_SAMPLES do
        local d = lf_dirs[i]
        ci = ci + 1; consts[ci] = d ~= nil and d[1] or 0.0
        ci = ci + 1; consts[ci] = d ~= nil and d[2] or 0.0
        ci = ci + 1; consts[ci] = d ~= nil and d[3] or 0.0
        ci = ci + 1; consts[ci] = d ~= nil and d[4] or 0.0
    end

    local ps_ok = false
    local ps_err = nil
    local ok_call, err_call = pcall(function()
        obj.clearbuffer("object", ATLAS, ATLAS)
        obj.pixelshader("fogatlas", "object", nil, consts, "copy")
        ps_ok = true
    end)
    if not ok_call then ps_err = err_call end

    ------------------------------------------------------------
    -- 2) 3D ハードウェア Z バッファへ奥→手前の順に一括描画
    ------------------------------------------------------------
    obj.setoption("drawtarget", "framebuffer")
    obj.setoption("culling", 0)
    obj.setoption("sampler", "clamp")

    local total_v = 0

    if ps_ok then
        local verts = {}
        local vi = 0

        if not use_sphere then
            pcall(function() obj.setoption("billboard", 0) end)
            for si = n_sl - 1, 0, -1 do
                local tx_i = si % TILES_X
                local ty_i = math.floor(si / TILES_X)
                local u0 = (tx_i * TILE + PAD) / ATLAS
                local u1 = ((tx_i + 1) * TILE - PAD) / ATLAS
                local v0 = (ty_i * TILE + PAD) / ATLAS
                local v1 = ((ty_i + 1) * TILE - PAD) / ATLAS

                local z = start_s + (si + 0.5) * dz
                local rxw = r_x * (hw_k * z)
                local ryw = r_y * (hw_k * z)
                local rzw = r_z * (hw_k * z)
                local dxw = d_x * (hh_k * z)
                local dyw = d_y * (hh_k * z)
                local dzw = d_z * (hh_k * z)

                local cx = cam_x + f_x * z - obj_x
                local cy = cam_y + f_y * z - obj_y
                local cz = cam_z + f_z * z - obj_z

                verts[vi + 1] = { (cx - rxw - dxw) / zoom, (cy - ryw - dyw) / zoom, (cz - rzw - dzw) / zoom, u0, v0 }
                verts[vi + 2] = { (cx + rxw - dxw) / zoom, (cy + ryw - dyw) / zoom, (cz + rzw - dzw) / zoom, u1, v0 }
                verts[vi + 3] = { (cx + rxw + dxw) / zoom, (cy + ryw + dyw) / zoom, (cz + rzw + dzw) / zoom, u1, v1 }
                verts[vi + 4] = { (cx - rxw + dxw) / zoom, (cy - ryw + dyw) / zoom, (cz - rzw + dzw) / zoom, u0, v1 }
                vi = vi + 4
            end
        else
            local r_vol = hw_k
            local ry_ratio = hh_k / r_vol
            if use_edit_billboard then
                -- 単体・等方霧（cam==nil かつ h_fall_k==0）の編集視点のみマウスドラッグ追従のため billboard=3 を維持
                obj.ox = tx - obj_x
                obj.oy = ty - obj_y
                obj.oz = tz - obj_z
                pcall(function() obj.setoption("billboard", 3) end)
                for si = n_sl - 1, 0, -1 do
                    local tx_i = si % TILES_X
                    local ty_i = math.floor(si / TILES_X)
                    local u0 = (tx_i * TILE + PAD) / ATLAS
                    local u1 = ((tx_i + 1) * TILE - PAD) / ATLAS
                    local v0 = (ty_i * TILE + PAD) / ATLAS
                    local v1 = ((ty_i + 1) * TILE - PAD) / ATLAS

                    local s = start_s + (si + 0.5) * dz
                    local sq = r_vol * r_vol - s * s
                    local rad_s = sq > 0 and math.sqrt(sq) or 0
                    if rad_s < 200 then rad_s = 200 end
                    local hx = rad_s / zoom
                    local hy = (rad_s * ry_ratio) / zoom
                    local sz = s / zoom

                    verts[vi + 1] = { -hx, -hy, sz, u0, v0 }
                    verts[vi + 2] = {  hx, -hy, sz, u1, v0 }
                    verts[vi + 3] = {  hx,  hy, sz, u1, v1 }
                    verts[vi + 4] = { -hx,  hy, sz, u0, v1 }
                    vi = vi + 4
                end
            else
                -- カメラ制御下（view_mode==2 球状モード）では billboard=3 を廃止し、明示的な正規直交基底 (r, d, f) で展開
                pcall(function() obj.setoption("billboard", 0) end)
                for si = n_sl - 1, 0, -1 do
                    local tx_i = si % TILES_X
                    local ty_i = math.floor(si / TILES_X)
                    local u0 = (tx_i * TILE + PAD) / ATLAS
                    local u1 = ((tx_i + 1) * TILE - PAD) / ATLAS
                    local v0 = (ty_i * TILE + PAD) / ATLAS
                    local v1 = ((ty_i + 1) * TILE - PAD) / ATLAS

                    local s = start_s + (si + 0.5) * dz
                    local sq = r_vol * r_vol - s * s
                    local rad_s = sq > 0 and math.sqrt(sq) or 0
                    if rad_s < 200 then rad_s = 200 end
                    local hx_w = rad_s
                    local hy_w = rad_s * ry_ratio

                    local rxw, ryw, rzw = r_x * hx_w, r_y * hx_w, r_z * hx_w
                    local dxw, dyw, dzw = d_x * hy_w, d_y * hy_w, d_z * hy_w
                    local cx = tx + f_x * s - obj_x
                    local cy = ty + f_y * s - obj_y
                    local cz = tz + f_z * s - obj_z

                    verts[vi + 1] = { (cx - rxw - dxw) / zoom, (cy - ryw - dyw) / zoom, (cz - rzw - dzw) / zoom, u0, v0 }
                    verts[vi + 2] = { (cx + rxw - dxw) / zoom, (cy + ryw - dyw) / zoom, (cz + rzw - dzw) / zoom, u1, v0 }
                    verts[vi + 3] = { (cx + rxw + dxw) / zoom, (cy + ryw + dyw) / zoom, (cz + rzw + dzw) / zoom, u1, v1 }
                    verts[vi + 4] = { (cx - rxw + dxw) / zoom, (cy - ryw + dyw) / zoom, (cz - rzw + dzw) / zoom, u0, v1 }
                    vi = vi + 4
                end
            end
        end

        obj.drawpoly(verts, 4, base_alpha)
        total_v = vi
    else
        --------------------------------------------------------
        -- 予備フォールバック（万一ピクセルシェーダーが利用不可の環境向け）
        --------------------------------------------------------
        if P.log_mode and ps_err ~= nil then
            pcall(function()
                print("@error", "VolumetricFog3D v2.06 シェーダー失敗（CPU予備描画）: " .. tostring(ps_err))
            end)
        end
        local gx, gy = 14, 8
        local verts = {}
        local vi = 0
        local dz_fb = depth_span / n_sl
        local tau_k = dens * 0.00095 * dz_fb
        for si = n_sl - 1, 0, -1 do
            local z = near_z + (si + 0.5) * dz_fb
            for j = 0, gy - 1 do
                for i = 0, gx - 1 do
                    local su0, su1 = (i / gx) * 2 - 1, ((i + 1) / gx) * 2 - 1
                    local sv0, sv1 = (j / gy) * 2 - 1, ((j + 1) / gy) * 2 - 1
                    local uu0, uu1 = su0 * sp * half_w * z, su1 * sp * half_w * z
                    local vv0, vv1 = sv0 * sp * half_h * z, sv1 * sp * half_h * z
                    local em = math.min(1, math.max(0, (1 - math.abs((su0 + su1) * 0.5)) * 3))
                             * math.min(1, math.max(0, (1 - math.abs((sv0 + sv1) * 0.5)) * 3))
                    local mx = cam_x + f_x * z + r_x * ((uu0 + uu1) * 0.5) + d_x * ((vv0 + vv1) * 0.5) + wox
                    local my = cam_y + f_y * z + r_y * ((uu0 + uu1) * 0.5) + d_y * ((vv0 + vv1) * 0.5) + woy
                    local mz = cam_z + f_z * z + r_z * ((uu0 + uu1) * 0.5) + d_z * ((vv0 + vv1) * 0.5) + woz
                    local nn = math.sin((mx * 0.86 + my * 0.38 + mz * 0.12) / ns) * 0.55
                             + math.sin((my * 0.81 - mx * 0.31 + mz * 0.17) * 1.7 / ns) * 0.45
                    nn = math.max(0, math.min(1, nn * 0.5 + 0.5))
                    local a = tau_k * em * ((0.12 + 1.9 * nn * nn) * pv + 0.75 * (1 - pv)) * base_alpha
                    if a > 0.9 then a = 0.9 end
                    local x00 = (cam_x + f_x * z + r_x * uu0 + d_x * vv0 - obj_x) / zoom
                    local y00 = (cam_y + f_y * z + r_y * uu0 + d_y * vv0 - obj_y) / zoom
                    local z00 = (cam_z + f_z * z + r_z * uu0 + d_z * vv0 - obj_z) / zoom
                    local x10 = (cam_x + f_x * z + r_x * uu1 + d_x * vv0 - obj_x) / zoom
                    local y10 = (cam_y + f_y * z + r_y * uu1 + d_y * vv0 - obj_y) / zoom
                    local z10 = (cam_z + f_z * z + r_z * uu1 + d_z * vv0 - obj_z) / zoom
                    local x11 = (cam_x + f_x * z + r_x * uu1 + d_x * vv1 - obj_x) / zoom
                    local y11 = (cam_y + f_y * z + r_y * uu1 + d_y * vv1 - obj_y) / zoom
                    local z11 = (cam_z + f_z * z + r_z * uu1 + d_z * vv1 - obj_z) / zoom
                    local x01 = (cam_x + f_x * z + r_x * uu0 + d_x * vv1 - obj_x) / zoom
                    local y01 = (cam_y + f_y * z + r_y * uu0 + d_y * vv1 - obj_y) / zoom
                    local z01 = (cam_z + f_z * z + r_z * uu0 + d_z * vv1 - obj_z) / zoom
                    verts[vi + 1] = { x00, y00, z00, col_r * a, col_g * a, col_b * a, a }
                    verts[vi + 2] = { x10, y10, z10, col_r * a, col_g * a, col_b * a, a }
                    verts[vi + 3] = { x11, y11, z11, col_r * a, col_g * a, col_b * a, a }
                    verts[vi + 4] = { x00, y00, z00, col_r * a, col_g * a, col_b * a, a }
                    verts[vi + 5] = { x11, y11, z11, col_r * a, col_g * a, col_b * a, a }
                    verts[vi + 6] = { x01, y01, z01, col_r * a, col_g * a, col_b * a, a }
                    vi = vi + 6
                    if vi >= 5400 then
                        obj.drawpoly(verts, 3)
                        total_v = total_v + vi
                        verts = {}
                        vi = 0
                    end
                end
            end
        end
        if vi > 0 then
            obj.drawpoly(verts, 3)
            total_v = total_v + vi
        end
    end

    ------------------------------------------------------------
    -- ログ（中文 / Default=日本語 / 非中日=英語 自動切替・セッション永続キャッシュ）
    ------------------------------------------------------------
    if P.log_mode then
        pcall(function()
            local ui_lang = vfog_detect_ui_lang()

            local msg
            if ui_lang == "zh" then
                local vmode_str = edit_cam_live and "编辑视角(实时3D)" or (use_sphere and (use_edit_billboard and "编辑视角3D球" or "世界轴3D球") or "摄像机控制")
                local backend = ps_ok and string.format("GPU(%dx%d)", ATLAS, ATLAS) or "CPU后备"
                msg = string.format(
                    "VolumetricFog3D v2.06  %s  视角=%s  切片=%d  顶点=%d  距离=%.0f..%.0f",
                    backend, vmode_str, n_sl, total_v, near_z, near_z + depth_span)
            elseif ui_lang == "de" then
                local vmode_str = edit_cam_live and "Bearbeitungsansicht(Live3D)" or (use_sphere and (use_edit_billboard and "Bearbeitungsansicht-3DKugel" or "Weltachsen-3DKugel") or "Kamerasteuerung")
                local backend = ps_ok and string.format("GPU(%dx%d)", ATLAS, ATLAS) or "CPU-Fallback"
                msg = string.format(
                    "VolumetricFog3D v2.06  %s  Ansicht=%s  Scheiben=%d  Verts=%d  Distanz=%.0f..%.0f",
                    backend, vmode_str, n_sl, total_v, near_z, near_z + depth_span)
            elseif ui_lang == "en" then
                local vmode_str = edit_cam_live and "EditView(Live3D)" or (use_sphere and (use_edit_billboard and "EditView-3DSphere" or "WorldAxis-3DSphere") or "CameraControl")
                local backend = ps_ok and string.format("GPU(%dx%d)", ATLAS, ATLAS) or "CPU-Fallback"
                msg = string.format(
                    "VolumetricFog3D v2.06  %s  view=%s  slices=%d  verts=%d  dist=%.0f..%.0f",
                    backend, vmode_str, n_sl, total_v, near_z, near_z + depth_span)
            else
                local vmode_str = edit_cam_live and "編集視点(実時間3D)" or (use_sphere and (use_edit_billboard and "編集視点3D球" or "世界軸3D球") or "カメラ制御")
                local backend = ps_ok and string.format("GPU(%dx%d)", ATLAS, ATLAS) or "CPU予備"
                msg = string.format(
                    "VolumetricFog3D v2.06  %s  視点=%s  スライス=%d  頂点=%d  距離=%.0f..%.0f",
                    backend, vmode_str, n_sl, total_v, near_z, near_z + depth_span)
            end
            local now_t = vfog_wall_time_sec()
            local last = _VFOG_PERSIST.last_log
            if type(global) == "table" and type(global.fogvol_log3) == "string" and last == nil then
                last = global.fogvol_log3
            end
            if last ~= msg and (now_t - (_VFOG_PERSIST.last_log_t or -999.0)) >= 0.25 then
                _VFOG_PERSIST.last_log = msg
                _VFOG_PERSIST.last_log_t = now_t
                if type(global) == "table" then global.fogvol_log3 = msg end
                print("@info", msg)
            end
        end)
    end
end

fog_frame()
